From b11e053ebc457da2e781a17077e69ee811aacbf2 Mon Sep 17 00:00:00 2001
From: S7ruc7ureV01d <S7ruc7ureV01d@users.noreply.github.com>
Date: Wed, 14 Oct 2026 23:04:07 -0300
Subject: [PATCH 5/8] fujisan: provide libprotobuf-old and libwpa_client

QCRIL's libsettings.so needs libprotobuf-old.so (protobuf 3.0 ABI) and
libprotobuf-cpp-full-legacy does not exist in 19.1, so both rild instances
crash-looped. Ship Android 9's VNDK protobuf under the old name; it exports
every symbol libsettings uses. cnd needs libwpa_client.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 radio-compat/Android.bp                       |  20 ++++++++++++++++++
 radio-compat/prebuilt/arm/libprotobuf-old.so  | Bin 0 -> 1402628 bytes
 .../prebuilt/arm64/libprotobuf-old.so         | Bin 0 -> 1914544 bytes
 3 files changed, 20 insertions(+)
 create mode 100644 radio-compat/Android.bp
 create mode 100755 radio-compat/prebuilt/arm/libprotobuf-old.so
 create mode 100755 radio-compat/prebuilt/arm64/libprotobuf-old.so

diff --git a/radio-compat/Android.bp b/radio-compat/Android.bp
new file mode 100644
index 0000000..a019396
--- /dev/null
+++ b/radio-compat/Android.bp
@@ -0,0 +1,20 @@
+// The stock QCRIL libsettings.so links libprotobuf-old.so (protobuf 3.0 ABI).
+// Android 9's VNDK libprotobuf-cpp-full exports every symbol it uses, so ship
+// that binary (copied from prebuilts/vndk/v28) under the old name.
+cc_prebuilt_library_shared {
+    name: "libprotobuf-old",
+    vendor: true,
+    strip: {
+        none: true,
+    },
+    check_elf_files: false,
+    compile_multilib: "both",
+    target: {
+        android_arm64: {
+            srcs: ["prebuilt/arm64/libprotobuf-old.so"],
+        },
+        android_arm: {
+            srcs: ["prebuilt/arm/libprotobuf-old.so"],
+        },
+    },
+}
diff --git a/radio-compat/prebuilt/arm/libprotobuf-old.so b/radio-compat/prebuilt/arm/libprotobuf-old.so
new file mode 100755
index 0000000000000000000000000000000000000000..f86277e61f0508e1abed55b3233d9a2118276afe
GIT binary patch
