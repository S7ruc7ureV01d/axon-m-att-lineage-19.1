From cd70a1a9bf6181f32a2e64c2cf579f7fed49c810 Mon Sep 17 00:00:00 2001
From: S7ruc7ureV01d <S7ruc7ureV01d@users.noreply.github.com>
Date: Wed, 14 Oct 2026 23:04:07 -0300
Subject: [PATCH 4/8] fujisan: AT&T FPC: legacy wrapper over stock
 fingerprint.fpc.so

The CN/JP Oreo FPC service sends commands the AT&T fpcapp64 TA rejects
("fpc_ta_sensor_command_handler unknown command 10"), so enumerate fails
and Android 12's cleanup client blocks every later fingerprint request
(Settings' I Agree stays disabled). Build a fujisan copy of the AOSP 2.1
legacy wrapper and load the stock AT&T module via ro.hardware.fingerprint.
The Nougat module reports nothing for an empty template DB, so answer
enumerate with fid 0 / remaining 0 if it stays silent for 500 ms.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device.mk                                     |  22 +-
 fingerprint/Android.bp                        |  23 ++
 fingerprint/BiometricsFingerprint.cpp         | 383 ++++++++++++++++++
 fingerprint/BiometricsFingerprint.h           |  91 +++++
 ...metrics.fingerprint@2.1-service.fujisan.rc |   8 +
 ...etrics.fingerprint@2.1-service.fujisan.xml |  11 +
 fingerprint/service.cpp                       |  48 +++
 sepolicy/file_contexts                        |   3 +
 8 files changed, 580 insertions(+), 9 deletions(-)
 create mode 100644 fingerprint/Android.bp
 create mode 100644 fingerprint/BiometricsFingerprint.cpp
 create mode 100644 fingerprint/BiometricsFingerprint.h
 create mode 100644 fingerprint/android.hardware.biometrics.fingerprint@2.1-service.fujisan.rc
 create mode 100644 fingerprint/android.hardware.biometrics.fingerprint@2.1-service.fujisan.xml
 create mode 100644 fingerprint/service.cpp

diff --git a/device.mk b/device.mk
index f4e549e..df1bc7a 100644
--- a/device.mk
+++ b/device.mk
@@ -127,18 +127,22 @@ PRODUCT_PACKAGES += \
 # libxml2 API is not ABI-compatible with this legacy Qualcomm surface.
 PRODUCT_PACKAGES += \
     libril-compat \
-    libprotobuf-cpp-full-legacy
+    libprotobuf-old
 
-# The FPC service itself remains proprietary on this device.  Keep only the
-# standard framework interface libraries and wrapper service source-built, then
-# replace the installed wrapper binary with the proprietary FPC implementation
-# at packaging time.  This keeps the standard init/VINTF wiring while avoiding
-# the incompatible AOSP implementation at runtime.
+# Qualcomm cnd (libcne.so) links the wpa_supplicant control client.
+PRODUCT_PACKAGES += \
+    libwpa_client
+
+# AT&T units: the CN/JP Oreo FPC service speaks a different protocol than the
+# AT&T fpcapp64 TA in /firmware/image ("unknown command 10").  Run the AOSP
+# legacy wrapper over the stock AT&T Nougat fingerprint.fpc.so module instead.
 PRODUCT_PACKAGES += \
     android.hardware.biometrics.fingerprint@2.1 \
-    android.hardware.biometrics.fingerprint@2.1-service \
-    android.hidl.base@1.0 \
-    fujisan_fingerprint_blob_overlay
+    android.hardware.biometrics.fingerprint@2.1-service.fujisan \
+    android.hidl.base@1.0
+
+PRODUCT_VENDOR_PROPERTIES += \
+    ro.hardware.fingerprint=fpc
 
 # Oreo vendor blobs depend on vendor-visible HIDL runtime libraries. The
 # legacy interface sonames android.hidl.base@1.0.so and
diff --git a/fingerprint/Android.bp b/fingerprint/Android.bp
new file mode 100644
index 0000000..b4c8ff7
--- /dev/null
+++ b/fingerprint/Android.bp
@@ -0,0 +1,23 @@
+// AOSP fingerprint@2.1 legacy wrapper (hardware/interfaces/biometrics/
+// fingerprint/2.1/default) for the stock AT&T fingerprint.fpc.so module, plus
+// an empty-enumerate fallback that module needs on Android 12.
+cc_binary {
+    name: "android.hardware.biometrics.fingerprint@2.1-service.fujisan",
+    defaults: ["hidl_defaults"],
+    init_rc: ["android.hardware.biometrics.fingerprint@2.1-service.fujisan.rc"],
+    vintf_fragments: ["android.hardware.biometrics.fingerprint@2.1-service.fujisan.xml"],
+    vendor: true,
+    relative_install_path: "hw",
+    srcs: [
+        "BiometricsFingerprint.cpp",
+        "service.cpp",
+    ],
+    shared_libs: [
+        "libcutils",
+        "liblog",
+        "libhidlbase",
+        "libhardware",
+        "libutils",
+        "android.hardware.biometrics.fingerprint@2.1",
+    ],
+}
diff --git a/fingerprint/BiometricsFingerprint.cpp b/fingerprint/BiometricsFingerprint.cpp
new file mode 100644
index 0000000..04b8af9
--- /dev/null
+++ b/fingerprint/BiometricsFingerprint.cpp
@@ -0,0 +1,383 @@
